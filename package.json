{
  "name": "atc",
  "private": true,
  "version": "0.7.7",
  "type": "module",
  "description": "ATC - Agent Terminal Control. A project and session sidebar wrapped around a real terminal, for driving coding agents.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c sidecar/vite.config.ts",
    "preview": "vite preview",
    "play": "bun scripts/play.mjs",
    "test": "bun run test:ts && bun run test:go",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "lint": "bun run lint:go && bun run check",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --config ./svelte.config.js && tsc -p sidecar/tsconfig.json",
    "test:e2e": "bun e2e/run.mjs",
    "bindings": "bun -e \"import('./scripts/wails-cli.mjs').then((m) => m.runWails(['generate', 'module']))\"",
    "desktop:build": "bun scripts/build.mjs",
    "desktop:dev": "bun scripts/dev.mjs",
    "test:go": "go test ./...",
    "lint:go": "go vet ./... && bun -e \"const o=require('child_process').execSync('gofmt -l app.go app_test.go limits.go main.go parity_test.go internal')+'';if(o.trim()){console.error('Run gofmt -w on: '+o);process.exit(1)}\"",
    "desktop:package": "bun scripts/package.mjs"
  },
  "dependencies": {
    "@milkdown/core": "7.23.0",
    "@milkdown/plugin-history": "7.23.0",
    "@milkdown/plugin-listener": "7.23.0",
    "@milkdown/preset-commonmark": "7.23.0",
    "@milkdown/preset-gfm": "7.23.0",
    "@milkdown/utils": "7.23.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.332",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/mdast": "4.0.4",
    "jsdom": "^31.0.1",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "webdriverio": "^10.2.0"
  }
}
