{
  "name": "atc",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "description": "ATC - Agent Terminal Control. A project and session sidebar wrapped around a real terminal, for driving coding agents.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "play": "node scripts/play.mjs",
    "test": "npm run test:ts && npm run test:go",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "lint": "npm run lint:go && npm run check",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "test:e2e": "node e2e/run.mjs",
    "desktop:build": "node scripts/build.mjs",
    "desktop:dev": "node scripts/dev.mjs",
    "test:go": "go test ./...",
    "lint:go": "go vet ./...",
    "desktop:package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "webdriverio": "^9.32.0"
  }
}
