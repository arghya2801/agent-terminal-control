{
  "name": "atc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ATC - Agent Terminal Control. A project and session sidebar wrapped around a real terminal, for driving coding agents.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "play": "cross-env ATC_CONFIG_DIR=./playground/config ATC_DEV=1 tauri dev",
    "test": "npm run test:ts && npm run test:rs",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "npm run lint:rs && npm run check",
    "lint:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "svelte-check --tsconfig ./tsconfig.app.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "2.11.1",
    "@tsconfig/svelte": "^5.0.4",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
