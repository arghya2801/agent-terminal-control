# --- node / vite ---
node_modules/
dist/
.vite/
*.local
coverage/

# --- rust / tauri ---
src-tauri/target/
src-tauri/gen/

# --- env ---
.env
.env.*
!.env.example

# --- dev playground (generated settings + cache) ---
/playground/config/

# --- misc ---
*.log
.DS_Store
Thumbs.db

# --- icon generation ---
# `tauri icon` emits mobile icon sets; this is a Windows desktop app and does not
# build them. Deleted rather than committed, and ignored so a regeneration cannot
# quietly reintroduce ~40 unused files.
src-tauri/icons/android/
src-tauri/icons/ios/
# Proof renders for eyeballing the mark at small sizes; regenerate with make-icon.mjs.
assets/preview/

# Development log: local notes, not part of the published project.
SESSION.md

# Demo recording script, kept local.
scripts/demo.ps1
# `npm run play` resolves its config dir from src-tauri, so the playground lands here too.
src-tauri/playground/
