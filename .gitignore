# --- node / vite ---
node_modules/
dist/
.vite/
*.local
coverage/

# --- go / wails ---
/build/bin/
/build/e2e/
/build/conpty/
/build/webdriver/
/.go-cache/
# The runtime is regenerated by every Wails run; the bindings in wailsjs/go are committed.
/wailsjs/runtime/
/package.json.md5
# Wails dev watches a generated mirror of the Go sources (scripts/dev-host.mjs).
/wails-dev-work/
/.wails-dev/

# --- env ---
.env
.env.*
!.env.example

# --- dev playground (generated settings + cache) ---
/playground/

# --- e2e output: screenshots and runtime memory samples ---
/benchmarks/

# --- misc ---
*.log
.DS_Store
Thumbs.db

# Proof renders for eyeballing the mark at small sizes; regenerate with make-icon.mjs.
assets/preview/

# Development log: local notes, not part of the published project.
SESSION.md

# Demo recording script, kept local.
scripts/demo.ps1
